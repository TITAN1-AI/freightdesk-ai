{
  "manifest_version": 3,
  "name": "FreightDesk Ascend X1",
  "short_name": "Ascend X1",
  "version": "0.6.2",
  "description": "Owner-enrolled, host-leased Ascend read-only runtime. Writes unavailable. Native host is Windows-only.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["nativeMessaging", "storage", "alarms", "scripting"],
  "host_permissions": ["https://ascendtms.com/*"],
  "background": {"service_worker": "background.js"},
  "action": {
    "default_popup": "popup.html",
    "default_title": "FreightDesk Ascend X1",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [{
    "matches": ["https://ascendtms.com/*"],
    "js": ["build.js", "contract.js", "read-errors.js", "load-board-view.js", "detail-scope.js", "webbridge.js", "mapping-scope.js", "workspace.js", "reader.js", "content.js"],
    "run_at": "document_idle",
    "all_frames": false,
    "world": "ISOLATED"
  }],
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'"}
}
