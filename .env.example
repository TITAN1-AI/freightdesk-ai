# Demo only. This release rejects live operating modes.
FREIGHTDESK_MODE=demo
FREIGHTDESK_TENANT=booking-logistics
FREIGHTDESK_TIMEZONE=America/Guatemala
# Optional local demo operator token; otherwise generated under runtime Tokens/demo-owner-token.txt.
FREIGHTDESK_OWNER_TOKEN=
# Optional demo agent Bearer for /v1/ascend and /v1/portable (not OAuth). Else POST /v1/agent/session
# or Tokens/demo-agent-token.txt. Minimum 32 characters. Never commit the value.
FREIGHTDESK_AGENT_TOKEN=
# Separate live read-view access; demo bootstrap cannot read live POC data.
FREIGHTDESK_LIVE_VIEW_TOKEN=
# Reserved for Milestone 2. Never paste a real token into a conversation.
FREIGHTDESK_RUNTIME_ROOT=C:\FreightDeskRuntime
CARRIERVIEW_AGENT_API_TOKEN=
CARRIERVIEW_TENANT_API_TOKEN=
CARRIERVIEW_BASE_URL=
CARRIERVIEW_ORIGIN_VERIFIED=false
CARRIERVIEW_READS_AUTHORIZED=false
OPENAI_API_KEY=
FREIGHTDESK_MODEL_PROVIDER=openai
FREIGHTDESK_MODEL=gpt-5.6-sol
LOCAL_MODEL_BASE_URL=
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
QUO_API_KEY=
BROKERCARRIER_API_KEY=
# CarrierView API service credential explicitly selected by owner; employee API execution unavailable.
CARRIERVIEW_CREDENTIAL_CLASS=tenant
CARRIERVIEW_ELEVATION_REASON="CarrierView API requires manager/admin credential; Avery employee token is not API-eligible."
